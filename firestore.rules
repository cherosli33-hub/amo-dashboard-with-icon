rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function designatedAdmin() {
      return verifiedEmail() && request.auth.token.email in [
        'cherosli33@gmail.com',
        'cherosli@moh.gov.my'
      ];
    }
    function designatedSupervisor() {
      return verifiedEmail() && request.auth.token.email in [
        'mdrafi@moh.gov.my',
        'yusseriharon6835@gmail.com'
      ];
    }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function staff() { return signedIn() && profile().active == true && profile().role in ['supervisor', 'admin']; }
    function admin() { return signedIn() && profile().active == true && profile().role == 'admin'; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && (
          (designatedAdmin() && request.resource.data.role == 'admin' && request.resource.data.active == true)
          || (designatedSupervisor() && request.resource.data.role == 'supervisor' && request.resource.data.active == true)
          || (!designatedAdmin() && !designatedSupervisor()
            && request.resource.data.role == 'pending' && request.resource.data.active == false)
        );
      allow read: if signedIn() && (request.auth.uid == uid || staff());
      allow update: if admin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']))
        || (request.auth.uid == uid && designatedAdmin()
          && request.resource.data.role == 'admin' && request.resource.data.active == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name', 'role', 'active', 'lastLoginAt']))
        || (request.auth.uid == uid && designatedSupervisor()
          && request.resource.data.role == 'supervisor' && request.resource.data.active == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name', 'role', 'active', 'lastLoginAt']));
      allow delete: if false;
    }

    // Rekod operasi: pengguna biasa menggunakan Firebase Anonymous Auth di belakang tabir.
    match /procedure_cases/{documentId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }
    match /asthma_assessments/{documentId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }
    match /phc_inspections/{documentId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }
    match /girn_inspections/{documentId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    // Penemuan boleh dihantar oleh app biasa, tetapi tindakan/kemas kini hanya oleh penyelia/admin.
    match /phc_findings/{documentId} {
      allow read, create: if signedIn();
      allow update: if staff();
      allow delete: if false;
    }
    match /girn_findings/{documentId} {
      allow read, create: if signedIn();
      allow update: if staff();
      allow delete: if false;
    }

    // Saluran umum untuk notifikasi/tindakan penyelia daripada mana-mana modul.
    match /supervisor_actions/{documentId} {
      allow create: if signedIn();
      allow read, update: if staff();
      allow delete: if false;
    }
  }
}
